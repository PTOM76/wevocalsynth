{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "vite-plugin-pwa/react"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "paths": { "pevenmui": ["./pevenmui/src/index.ts"], "pevenmui/pwa": ["./pevenmui/src/pwa/index.ts"], "pevenmui/web": ["./pevenmui/src/web/index.ts"], "wevocal-lib": ["./wevocal-lib/web/src/index.ts"], "wevocal-lib/react": ["./wevocal-lib/web/src/react/index.ts"] },
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "pevenmui/src", "wevocal-lib/web/src"]
}
